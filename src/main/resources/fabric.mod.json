{
  "schemaVersion": 1,
  "id": "packedblocks",
  "version": "${version}",
  "name": "Packed Blocks",
  "description": "A lightweight, vanilla-friendly Fabric mod adding compressed storage blocks for common resources like Cobblestone, Dirt, and Netherrack.",
  "authors": ["xanderboy2001"],
  "contact": {
    "homepage": "https://github.com/xanderboy2001/packed-blocks",
    "sources": "https://github.com/xanderboy2001/packed-blocks",
    "issues": "https://github.com/xanderboy2001/packed-blocks/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/packedblocks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.xanderboy2001.packedblocks.PackedBlocks"],
    "client": ["io.github.xanderboy2001.packedblocks.PackedBlocksClient"],
    "fabric-datagen": [
      "io.github.xanderboy2001.packedblocks.datagen.ModDataGenerator"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0"
  }
}
