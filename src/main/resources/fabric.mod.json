{
  "schemaVersion": 1,
  "id": "packedblocks",
  "version": "${version}",
  "name": "Packed Blocks",
  "description": "A Fabric mod adding compressed blocks.",
  "authors": ["Alexander Christian"],
  "contact": {
    "homepage": "https://github.com/xanderboy2001/packed-blocks",
    "sources": "https://github.com/xanderboy2001/packed-blocks"
  },
  "license": "CC0-1.0",
  "icon": "assets/packedblocks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.xanderboy2001.packedblocks.PackedBlocks"],
    "client": ["io.github.xanderboy2001.packedblocks.PackedBlocksClient"],
    "fabric-datagen": [
      "io.github.xanderboy2001.packedblocks.datagen.ModDataGenerator"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
